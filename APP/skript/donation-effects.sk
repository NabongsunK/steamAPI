# steamAPI + NR-Donation 후원 효과 (TNT)
# 필요: Skript, Skript-Reflect, NR-Donation 플러그인
# 설치: plugins/Skript/scripts/ 에 복사 후  →  sk reload donation-effects
#
# DonationEvent (net.teujaem.nrDonation.event.DonationEvent)
#   getPlatform()  — chzzk
#   getSender()    — 후원자 닉
#   getAmount()    — 금액 (원)
#   getMessage()   — 후원 메시지
#   getPlayer()    — 스트리머 (mc_username, 접속 중)

import:
  net.teujaem.nrDonation.event.DonationEvent

on DonationEvent:
    set {_platform} to event.getPlatform()
    set {_sender} to event.getSender()
    set {_amount} to event.getAmount()
    set {_message} to event.getMessage()
    set {_player} to event.getPlayer()

    if {_player} is not set:
        stop

  # --- 채팅 알림 ---
    broadcast "&8[&6후원&8/&e%{_platform}%&8] &f%{_sender}% &7→ &a%{_player}% &6%{_amount}%&f원"
    if {_message} is set:
        if {_message} is not "":
            if {_message} is not "null":
                broadcast "&7\"%{_message}%\""

  # --- 금액별 TNT (개수·금액은 자유롭게 수정) ---
    set {_tnt} to 0
    if {_amount} >= 50000:
        send title "&c&l대형 후원!" with subtitle "&e%{_sender}% &f%{_amount}%원" to {_player} for 3 seconds
        set {_tnt} to 5
    else if {_amount} >= 10000:
        set {_tnt} to 3
    else if {_amount} >= 5000:
        set {_tnt} to 2
    else if {_amount} >= 1000:
        set {_tnt} to 1

    loop {_tnt} times:
        set {_loc} to location (2 + loop-number * 0.5) meters above {_player}
        spawn primed tnt at {_loc}
